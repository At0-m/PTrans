DATABASE_URL=postgres://postgres:postgres@localhost:5433/ptrans?sslmode=disable
LISTEN_ADDR=:8080
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
JWT_ISSUER=ptrans
JWT_AUDIENCE=ptrans-api
PROVIDER_URL=http://localhost:8091
PROVIDER_API_KEY=replace-with-a-random-provider-key
PROVIDER_HTTP_TIMEOUT=5s
REFUND_POLL_INTERVAL=1s
REFUND_CHECK_INTERVAL=30s
REFUND_LEASE_DURATION=30s
REFUND_STUCK_AFTER=10m
REFUND_INITIAL_BACKOFF=2s
REFUND_MAX_BACKOFF=1m
REFUND_MAX_ATTEMPTS=5
REFUND_MAX_CHECK_FAILURES=5
REFUND_BATCH_SIZE=10
RATE_LIMIT_MUTATIONS_PER_MINUTE=20
MOCK_PROVIDER_MODE=ok
MOCK_PROVIDER_DELAY=8s
